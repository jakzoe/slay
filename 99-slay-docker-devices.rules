# Stellarnet before firmware init (04b4:8613)
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="04b4", ATTRS{idProduct}=="8613", GROUP:="uucp", MODE:="0666"

# Stellarnet, re-enumerated after firmware init (0bd7:a012)
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="0bd7", ATTRS{idProduct}=="a012", GROUP:="uucp", MODE:="0666"

# Thorlabs Spectrometer (second spec) (1313:8113)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1313", ATTRS{idProduct}=="8113", GROUP:="uucp", MODE:="0666"

# both FT232 serial bridges (ESP32 and LTB) share the same vendor and product ID 0403:6001
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", GROUP:="uucp", MODE:="0666"

# NKT laser, CP210x serial (10c4:ea60)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", GROUP:="uucp", MODE:="0666"

# Camera (0c45:62c0)
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="62c0", GROUP:="uucp", MODE:="0666"

# using the FT232 serial bridge instead of the ESP32
#SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", GROUP:="uucp", MODE:="0666"
